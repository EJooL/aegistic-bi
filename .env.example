# Aegistic Environment Configuration
# Copy this file to .env and adjust as needed.

# Intent parser mode: "deterministic" (default, offline-ready), "openai", or "gemini"
AEGISTIC_PARSER_MODE=deterministic

# Optional LLM API Keys (only required if AEGISTIC_PARSER_MODE is set to openai or gemini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Local DuckDB Data Warehouse path (relative to repo root or absolute)
AEGISTIC_DB_PATH=aegistic.duckdb

# Semantic Layer YAML path
AEGISTIC_SEMANTIC_MODEL_PATH=semantic_models/commerce.yaml

# Pinned dashboard SQLite persistence path
AEGISTIC_DASHBOARD_DB_PATH=semantic_engine/data/dashboards.sqlite3

# Evaluation benchmark report path
AEGISTIC_BENCHMARK_PATH=evaluation/results/benchmark_report.json

# FastAPI / Frontend CORS
AEGISTIC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
